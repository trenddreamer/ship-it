{
  // The base for the Factory's scripts, whose own tsconfig is
  // .sandcastle/agent-workflows/tsconfig.json. This one checks the root's
  // config files.
  "include": ["*.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
