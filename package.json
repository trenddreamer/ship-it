{
  "name": "ship-it",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "typecheck": "react-router typegen && tsc --noEmit && tsc -p .sandcastle/agent-workflows --noEmit",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "lint:boundaries": "depcruise app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run lint:boundaries && npm run test",
    "prepare": "husky",
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx app/db/migrate.ts",
    "db:seed": "tsx app/db/seed.ts",
    "db:reset": "tsx app/db/reset.ts && npm run db:migrate && npm run db:seed",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.14.0",
    "@react-router/dev": "^8.5.2",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.9.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@react-router/node": "^8.5.2",
    "@react-router/serve": "^8.5.2",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  }
}
