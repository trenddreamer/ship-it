{
  "name": "ship-it",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p .sandcastle/agent-workflows --noEmit",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepare": "husky",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.14.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
