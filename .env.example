# Copy to .env. React Router's Vite plugin loads it into process.env for
# `npm run dev` (and `npm run build`); a variable already set in your shell
# wins. `react-router-serve`, so production and the journey, never reads it.
# Never commit .env.

# With the Feedback App's credentials, Feedback opens real GitHub issues as
# the App, labelled `agent:explore`, which start the Factory. Leave all three
# unset to log Feedback to the console instead. The private key is the App's
# PEM; on one line, write `\n` for its line breaks. See app/config.server.ts.
FEEDBACK_APP_ID=
FEEDBACK_APP_PRIVATE_KEY=
FEEDBACK_APP_INSTALLATION_ID=
# The `repo:` label that routes Feedback to this app's Enrolled repo.
# FEEDBACK_REPO_LABEL=repo:marketplace
