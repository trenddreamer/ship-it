# Copy to .env. React Router's Vite plugin loads it into process.env for
# `npm run dev` (and `npm run build`); a variable already set in your shell
# wins. `react-router-serve`, so production and the journey, never reads it.
# Never commit .env.

# Feedback opens real GitHub issues, labelled `agent:explore`, which start
# the Factory. Leave unset to log Feedback to the console instead.
# Any token with Issues: write on this repo, e.g. `gh auth token`.
FEEDBACK_GITHUB_TOKEN=
